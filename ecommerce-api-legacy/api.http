@baseUrl = http://127.0.0.1:3000
@adminToken = {{$processEnv ADMIN_TOKEN}}
@password = {{$processEnv SEED_USER_PASSWORD}}

### Checkout da conta inicial - sucesso
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "Leonan",
  "eml": "leonan@fullcycle.com.br",
  "pwd": "{{password}}",
  "c_id": 2,
  "card": "4"
}

### Checkout - pagamento recusado pela simulação
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "Leonan",
  "eml": "leonan@fullcycle.com.br",
  "pwd": "{{password}}",
  "c_id": 1,
  "card": "5"
}

### Relatório financeiro administrativo
GET {{baseUrl}}/api/admin/financial-report
X-Admin-Token: {{adminToken}}

### Exclusão de usuário, matrículas e pagamentos
DELETE {{baseUrl}}/api/users/1
X-Admin-Token: {{adminToken}}
